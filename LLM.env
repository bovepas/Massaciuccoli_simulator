# =====================================================
# MODEL ROLE ROUTING
# =====================================================
# true: LLM_MODEL/LLM_ENDPOINT are used only for calls explicitly marked
# role="interpretation". Parsing/extraction/default calls use LLM_BASE_*.
# false: preserve legacy behaviour; LLM_MODEL is used for every call_llm().
LLM_USE_SELECTED_MODEL_FOR_INTERPRETATION_ONLY=false

# Base model for routing-adjacent LLM parsing/extraction calls.
# The semantic router itself uses nomic-embed-text and is unaffected.
LLM_BASE_PROFILE=llama32
LLM_BASE_MODEL=llama3.2:3b
LLM_BASE_ENDPOINT=http://ollama:11434/api/generate
LLM_BASE_MAX_PREDICT=1024

# Timeout
LLM_TIMEOUT=300

# =====================================================
# LOCAL FALLBACK
# =====================================================

LLM_FALLBACK_PROFILE=llama32

LLM_FALLBACK_MODEL=llama3.2:3b

LLM_FALLBACK_ENDPOINT=http://ollama:11434/api/generate

LLM_FALLBACK_MAX_PREDICT=512
